


function sendResourcepack(p: player):
	
	wait 20 ticks
        
	set {_url} to "https://download.mc-packs.net/pack/6889dd7ae2f90a231d96048ba0517f382202b349.zip"
	set {_hash} to "6889dd7ae2f90a231d96048ba0517f382202b349"
	set {_uuid} to random uuid
	send resource pack from url {_url} with uuid {_uuid} with hash {_hash} to {_p}



command /resourcepack:
	trigger:
		sendResourcepack(player)
