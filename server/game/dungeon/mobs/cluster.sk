function spawn_mage(l: location, scaling: number=1):

	spawn adult zombie at {_l}:
		set {_ent} to zombie
		set name of zombie to "&dMage"

		set chestplate of zombie to unbreakable leather chestplate with nbt from "{""minecraft:attribute_modifiers"":[{amount:0.0d,display:{type:""hidden""},id:""minecraft:armor"",operation:""add_value"",type:""minecraft:armor""}]}"
