
on drop:
	player's gamemode != creative
	if {-tempdata::%uuid of player%::dungeon} isn't set:
		cancel event

	else if event-item = {-dungeon::bag}:
		cancel event

on pickup:
	player's gamemode != creative
	if byte tag "pickup" of custom nbt of event-dropped item = 1:
		stop
	{-tempdata::%uuid of player%::dungeon} isn't set
	cancel event

