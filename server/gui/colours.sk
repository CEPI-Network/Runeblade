
on load:
	loop indices of {-colours::*}:
		clear {-colours::%loop-value%::*}
	clear {-colours::*}

	locally suppress variable save warnings
	loadColours()

function loadColours():

	set {_i} to iron sword
	set item model of {_i} to "rubishine"
	registerColour("&c&lRubishine", {_i}, 1, (rgb(255,63,81), rgb(191,32,48), rgb(133,22,32)), 0, true, ("sapphire" and "golden"))
	registerColour("&c&lRubishine", {_i}, 2, (rgb(168,168,168), rgb(80,80,80), rgb(40,40,40)), 0, true, ("sapphire" and "golden"))
	registerColour("&c&lRubishine", {_i}, 3, (rgb(253,131,116), rgb(252,100,91), rgb(252,71,77)), 0, true, ("sapphire" and "golden"))
	
	set {_i} to iron sword
	set item model of {_i} to "rubishine-sapphire"
	registerColour("&c&lRubishine &8» <##3f8eff>&lSAPPHIRE", {_i}, 1, (rgb(63,142,255), rgb(32,98,191), rgb(22,67,133)), 150, false)
	registerColour("&c&lRubishine &8» <##3f8eff>&lSAPPHIRE", {_i}, 2, (rgb(168,168,168), rgb(80,80,80), rgb(40,40,40)), 150, false)
	registerColour("&c&lRubishine &8» <##3f8eff>&lSAPPHIRE", {_i}, 3, (rgb(117,165,255), rgb(77,147,255), rgb(51,149,255)), 150, false)
	
	set {_i} to iron sword
