on load:
	locally suppress starting with expression warnings



command /duel [<player>]:
	trigger:

		if arg-1 is not set:
			openDuels(player)
		else if arg-1 = player:
			send "%prefix()% &7You can't send a duel request to yourself!"
			play sound "block.note_block.pling" at pitch 0.5 to player
		else:
			duelChallenge(player, arg-1)

on rightclick:
	clicked entity is an interaction
	{-display::duels::3} = clicked entity
	#name of clicked entity = "loadouts"
	openDuels(player)

on command:
	{-tempdata::%uuid of player%::duel::in-duel} = true
	full command contains "spawn" or "spectate"

	set {_in-duel::*} to (all players where [{-tempdata::%uuid of input%::duel::in-duel} is set])
	if size of {_in-duel::*} >= 2:
		cancel event
		send "%prefix()% &7You can't execute that command! You're in a duel!" to player
	else:
		send "%prefix()% &7Ending the duel..." to player
		wait 5 seconds
		clear {-tempdata::%uuid of player%::duel::*}



function openDuels(p: player, menu: string="main", page: integer=1):

	create gui with virtual chest inventory with 5 rows named "&c&l             DUELS":
		open gui to {_p}

		format gui slot (integers between 0 and 8) with red stained glass pane named "&0"
		format gui slot (integers between 36 and 44) with black stained glass pane named "&0"
		format gui slot 4 with spruce sign named "&c&lDUELS" with lore "", formatParagraph("Duel another player on the server or spectate an ongoing duel!") and "" with all item flags

		if {_menu} = "main":

			play sound "ui.button.click" to {_p}

			set {_in-duel::*} to (all players where [{-tempdata::%uuid of input%::duel::in-duel} is set])
			if {_in-duel::*} is set:
				loop {_in-duel::*}:
					set {_current::%loop-counter%} to "&e%loop-value%"
				

				format gui slot 22 with clock named "&e&lDUEL IN PROGRESS" with lore "", formatParagraph("There's already a duel going on!"), "", "%join {_current::*} with " &7and "% &7are in a duel!", "", "", "&e&lCLICK TO SPECTATE", "" with all item flags:
					spectateDuel({_p})
			
			else:
				format gui slot 21 with iron sword named "&c&lSTART A DUEL" with lore "", formatParagraph("Start dueling another player!"), "", "", "&e&lCLICK TO OPEN", "" with all item flags:
					openDuels({_p}, "duel")
				
				if inTeamDuelQueue({_p}) = true:
					format gui slot 23 with netherite sword named "&6&lQUEUE A TEAMDUEL" with lore "", formatParagraph("Enter a queue for a &f2v2 &7match!"), "", "", "&c&lCLICK TO LEAVE QUEUE", "" with all item flags:
						toggleTeamDuelQueue({_p})
						close {_p}'s inventory
				else:
					format gui slot 23 with netherite sword named "&6&lQUEUE A TEAMDUEL" with lore "", formatParagraph("Enter a queue for a &f2v2 &7match!"), "", "", "&a&lCLICK TO ENTER QUEUE", "" with all item flags:
						toggleTeamDuelQueue({_p})
						close {_p}'s inventory

						


		else if {_menu} = "duel":
			
			play sound "ui.button.click" to {_p}

			set {_pged::*} to page {_page} of (all players where [input != {_p}]) with 7 lines
			set {_slot} to 19
			loop {_pged::*}:
				set {_target} to loop-value
				
				format gui slot {_slot} with skull of loop-value named "&e%name of loop-value%" with lore "&8ᴘʟᴀʏᴇʀ", "", "", "&e&lCLICK TO CHALLENGE", "" with all item flags:
					challengeMenu({_p}, {_target})
				
				add 1 to {_slot}
			
			set {_next::*} to page {_page}+1 of (all players where [input != {_p}]) with 7 lines
			set {_prev::*} to page {_page}-1 of (all players where [input != {_p}]) with 7 lines
			if size of {_next::*} > 0:
				format gui slot 26 with arrow named "&a&lNEXT PAGE" with lore "":
					openDuels({_p}, "duel", {_page}+1)
			if size of {_prev::*} > 0:
				format gui slot 26 with arrow named "&a&lPREVIOUS PAGE" with lore "":
					openDuels({_p}, "duel", {_page}-1)
			
		


function challengeMenu(p: player, t: player):
	create gui with virtual chest inventory with 5 rows named "&c&l             DUELS" with shape "aaaasaaaa", "---------", "-1234567-", "---------", "bbbbbbbbb":
		open gui to {_p}

		format gui slot "a" with red stained glass pane named "&0"
		format gui slot "b" with black stained glass pane named "&0"
		set {_prefix} to {_t}'s prefix ? ""
		format gui slot "s" with skull of {_t} named "&f%{_prefix}%%{_t}%" with lore ""

		
		if {-tempdata::%uuid of {_p}%::duel::rune gains} is set:
			set {_status} to "&c&lCLICK TO DISABLE"
			set {_stat-cond} to "&a&lENABLED"
		else:
			set {_status} to "&a&lCLICK TO ENABLE"
			set {_stat-cond} to "&c&lDISABLED"

		set {_item} to oak sign named "<##2eadd7>RUNE GAINS ₪" with lore "&8ᴏᴘᴛɪᴏɴ", "", formatParagraph("&aEnable&7/&cDisable Rune Gains."), "", formatParagraph("Having this option enabled will affect your stats."), "", "", {_status}, "" with all item flags
		enchant {_item} with unbreaking 1 if {_status} = "&c&lCLICK TO DISABLE"

		#format gui slot "2" with {_item}:
		#	toggle({_p}, "rune gains")
		#	challengeMenu({_p}, {_t})
		format gui slot "4" with netherite sword named "&c&lSTART DUEL" with lore "", "", "&e&lCLICK TO START", "" with all item flags: # "&8 - <##2eadd7>₪ &fRune Gains &8» %{_stat-cond}%",
			duelChallenge({_p}, {_t})


local function toggle(p: player, opt: text):
	if {-tempdata::%uuid of {_p}%::duel::%{_opt}%} is set:
		clear {-tempdata::%uuid of {_p}%::duel::%{_opt}%}
		play sound "block.note_block.harp" at pitch 1 to {_p}
		send "%prefix()% Disabled &e%{_opt} in strict proper case%&7!" to {_p}
	else:
		set {-tempdata::%uuid of {_p}%::duel::%{_opt}%} to true
		play sound "block.note_block.harp" at pitch 2 to {_p}
		send "%prefix()% Enabled &e%{_opt} in strict proper case%&7!" to {_p}
	




function duelChallenge(p: player, t: player):

	if {-tempdata::%uuid of {_t}%::duel-request} = {_p}:
		play sound "block.note_block.pling" at pitch 0.5 to {_p}
		send "%prefix()% &7You've already challenged &f%{_t}% &7to a duel!" to {_p}
		stop

	if {-tempdata::%uuid of {_p}%::duel::rune gains} is set:
		set {_s} to " &8(&fRune <##2eadd7>₪ &fGains Enabled &8)"
	else:
		set {_s} to ""


	play sound "block.note_block.pling" at pitch 2 to {_p} and {_t}
	send "" to {_p} and {_t}
	send "&c&l DUEL &8» &7Sent a duel request to &f%{_t}%&7!" to {_p}
	send "<command:/acceptduel>&f  &c&lDUEL &8» &f%{_p}% &7has challenged you to a duel&7!%{_s}%" to {_t}
	send "<command:/acceptduel>&8   (&7Click to Accept&8)" to {_t}
	send "" to {_p} and {_t}

	set {-tempdata::%uuid of {_t}%::duel-request} to {_p}

	loop 30 times:
		wait 2 seconds
		exit loop if {-tempdata::%uuid of {_t}%::duel-request} isn't set
	
	stop if {-tempdata::%uuid of {_t}%::duel::in-duel} is set

	send "" to {_p} and {_t}
	send "&c&l DUEL &8» &7Your duel request to &f%{_t}% &7has expired." to {_p}
	send "&c&l DUEL &8» &f%{_p}%&7's duel request has expired." to {_t}
	send "" to {_p} and {_t}

	clear {-tempdata::%uuid of {_t}%::duel-request} if {-tempdata::%uuid of {_t}%::duel-request} = {_p}




command /acceptduel:
	trigger:
		{-tempdata::%uuid of player%::duel-request} is set
		{-tempdata::%uuid of player%::duel::in-duel} isn't set
		{-tempdata::%uuid of player%::dungeon} isn't set

		wait 1 tick

		set {_t} to {-tempdata::%uuid of player%::duel-request}
		if {_t} is not connected:
			send "%prefix()% &7That player is no longer online!"
			play sound "block.note_block.pling" at pitch 0.5 to player
		
		else if any:
			{-tempdata::%uuid of player%::combatlog} is set
			{-tempdata::%uuid of {_t}%::combatlog} is set
		then:
			send "%prefix()% &7A player is still in combat!"
			play sound "block.note_block.pling" at pitch 0.5 to player
		
		else if (all players where [{-tempdata::%uuid of input%::duel::in-duel} is set]) is set:
			send "%prefix()% &7A duel is already going on!"
			play sound "block.note_block.pling" at pitch 0.5 to player

		else:
			clear {-tempdata::%uuid of player%::duel-request}
			startDuel(player, {_t})
			


command /spectateduel:
	trigger:
		spectateDuel(player)













