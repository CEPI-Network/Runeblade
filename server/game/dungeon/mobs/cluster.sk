	set {_hit} to 0
	while {_ent} exists:
		if any:
			distance between {_ent} and (nearest player at {_ent}) > 250
			loop-counter >= 300 # bare minimum over 10m
			{_ent} is not alive
		then:
			exit loop


		target entity of {_ent} is set:
			set {_dist} to (distance between {_ent} and (target entity of {_ent})) ? 1
			if {_dist} <= 5.25:
				set {_hit} to mod({_hit}, 2)+1
				make {_ent} swing their main hand
				arcanumAction({_ent}, {_hit}, 1)

				wait {-weapons::arcanum::cooldown::%{_hit}%}
				wait "%random integer between 10 and 40% ticks" parsed as timespan
			else:
				wait 25 tick
		else:
			wait 20 tick

	kill {_ent}








function spawn_hound(l: location, scaling: number=1):

	spawn wolf at {_l}:
		set {_ent} to wolf
		set name of wolf to "&7Hound"

		apply infinite speed 1 to wolf:
			hide particles
		set byte tag "mob" of custom nbt of wolf to 1
		set wolf's maximum health to 5*{_scaling}
		set wolf's follow range attribute to 64
		heal wolf

	
	set {_hit} to 0
	while {_ent} exists:
		if any:
			distance between {_ent} and (nearest player at {_ent}) > 250
			loop-counter >= 300 # bare minimum over 10m
			{_ent} is not alive
		then:
			exit loop


		target entity of {_ent} is set:
			set {_dist} to (distance between {_ent} and (target entity of {_ent})) ? 1
			if {_dist} >= 10:
				chance of 25%:
					push {_ent} (vector from {_ent} to location 2 above target entity of {_ent}) at speed 1.5
				else:
					wait 40 tick
			else:
				wait 40 tick
		else:
			set {_nearest} to nearest player in radius 32 of {_ent} excluding (all players where [input's gamemode = spectator])
			set {_ent}'s target entity to {_nearest}
			wait 40 tick

	kill {_ent}



