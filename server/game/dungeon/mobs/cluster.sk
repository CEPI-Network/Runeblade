		set boots of zombie to unbreakable leather boots with nbt from "{""minecraft:attribute_modifiers"":[{amount:0.0d,display:{type:""hidden""},id:""minecraft:armor"",operation:""add_value"",type:""minecraft:armor""}]}"
		
		set int tag "minecraft:dyed_color" of nbt of (chestplate of zombie) to 8991080
		set int tag "minecraft:dyed_color" of nbt of (leggings of zombie) to 4856130
		set int tag "minecraft:dyed_color" of nbt of (boots of zombie) to 3021867
		
		set tool of zombie to unbreakable stick
		set zombie's tool's item model to "arcanum"

		apply infinite weakness 255 to zombie:
			hide particles
		set byte tag "mob" of custom nbt of zombie to 1
		set zombie's maximum health to 6*{_scaling}
