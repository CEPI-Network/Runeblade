on damage of player:
	if damage cause = campfire:
		cancel event


on entity knockback:
	cancel event

on entity change block:
	event-entity is a falling block
	cancel event

on teleport:
	player's gamemode = spectator
	teleport cause = spectate
	player does not have permission "skript.staff"
	cancel event

#on gamemode change:
#	wait 1 tick
#	set player's flight mode to true

on craft:
	cancel event

#on shoot:
#	shooter is a player
#	projectile's metadata "hook" is not set
#	cancel event

on respawn:
	# set player's flight mode to true
	# teleport player to location(-0.5, 75, -54.5, world "runeblade", 0, 0) retain passengers # spawn
	wait 1 tick
	apply infinite weakness 255 to player:
		hide the particles
		hide the icon


on projectile collide:
	isDamageableEntity(event-entity) = false
	cancel event


on hunger meter change:
	cancel event

