


# requires reloading this every time you edit one of the function calls
on rightclick on mannequin:
	set {_name} to string tag "name" of custom nbt of clicked entity

	if {_name} = "swordsmith":
		openSwordsmith(player)
		play sound "block.grindstone.use" at pitch 1.5 to player
	else if {_name} = "attunement master":
		set {_i} to player's tool
		set player's tool to air
		openAttunement(player, {_i})
		play sound "block.vault.insert_item" to player
	
	else if {_name} = "cosmetics":
		openCosmetics(player)
	else if {_name} = "challenges":
		openChallenges(player)
	else if {_name} = "skills":
		openSkills(player)

	else if {_name} = "tutorial":
		create gui with virtual chest inventory with 5 rows named "&a&l          TUTORIAL":
			open gui to player
			format gui slot (integers between 0 and 8) with lime stained glass pane named "&0"
			format gui slot (integers between 36 and 44) with lime stained glass pane named "&0"
			format gui slot 22 with oak sign named "&a&lRESTART TUTORIAL" with lore "", formatParagraph("Wanted to take another look at the tutorial? Revisit it and go over the server's mechanics!"), "", "&e&lCLICK TO START", "" with all item flags:
				startTutorial(player)

	else if {_name} = "dungeons":
		openDungeon(player)

	else if {_name} = "tut_swordsmith":
		openSwordsmith(player, true)
	else if {_name} = "tut_attunement":
		set {_i} to player's tool
		set player's tool to air
		openAttunement(player, {_i}, true)









function registerSkin(name: string, value: string, signature: string):
	set {_index} to uncolored {_name} in lowercase

	set {-registry::skin::%{_index}%::value} to {_value}
	set {-registry::skin::%{_index}%::signature} to {_signature}


function registerNPC(name: string, display: strings, loc: location, skin: string, bound: string={_}):
	set {_index} to uncolored {_name} in lowercase
	
	set {_value} to {-registry::skin::%{_skin}%::value}
	set {_signature} to {-registry::skin::%{_skin}%::signature}

	spawn mannequin at {_loc}:
		set {_ent} to entity
		make entity invulnerable
		setSkin(entity, {_value}, {_signature})
		set string tag "name" of custom nbt of entity to {_name}

	spawn text display at {_loc} ~ vector(0, 2.2, 0):
		set {_txt} to entity
		set billboard of entity to center
		set text of entity to {_display::*}
		add drop shadow to entity
		set color of entity to rgb(0, 0, 0, 0)
	set boolean tag "temp" of custom nbt of {_txt} to true

	if {_bound} is set:
		delete bound with id {_bound}
		wait 1 tick
		create temporary bound with id {_bound} within {_loc} ~ vector(4, 4, 4) and {_loc} ~ vector(-4, -4, -4):
			set bound value "npc" of event-bound to {_ent}


on load:
	wait 1 second
	loadNPCs()

function loadNPCs():

	loop all mannequins:
		kill all text displays in radius 3 of loop-value where [boolean tag "temp" of custom nbt of input = true]
		delete loop-value

	registerSkin("swordsmith", "", "")
	registerSkin("attunement", "", "")
	registerSkin("tutorial", "", "")
	registerSkin("cosmetics", "", "")
	registerSkin("skills", "", "")
	registerSkin("challenges", "", "")
	registerSkin("dungeons", "", "")


	# --
	set {_grad::swordsmith} to minimessage from "<gradient:#FF5555:#FF7575:#FF5555>← <bold>SWORDSMITH</bold> →"
	set {_grad::attunement} to minimessage from "<gradient:#AA00AA:#D936D9:#AA00AA><obf>-</obf> <bold>ATTUNEMENT MASTER</bold> <obf>-</obf>"
	set {_grad::cosmetics} to minimessage from "<gradient:#D182FF:#FF82F9:#D182FF>•<strikethrough>  </strikethrough> <bold>COSMETICS</bold> <strikethrough>  </strikethrough>•"
	set {_grad::skills} to minimessage from "<gradient:#FF5C7F:#DE3742:#FF5C7F>« <bold>SKILLS</bold> »"
	set {_grad::challenges} to minimessage from "<gradient:#F7C286:#FFD15C:#F7C286>🗡 <bold>CHALLENGES</bold> 🗡"
	set {_grad::dungeons} to minimessage from "<gradient:#B973FF:#DA73FF:#B973FF>•◆| <bold>DUNGEONS</bold> |◆•"
	set {_grad::tutorial} to minimessage from "<gradient:#94FF73:#58FC67:#94FF73>• <bold>TUTORIAL</bold> •"
	registerNPC("Swordsmith", ("%{_grad::swordsmith}%", "", formatParagraph("&7Select a <#F0F0F0>&nprimary&7 and <#F0F0F0>&nsecondary&7 weapon!"), "", "&6&lCLICK &6to View"), location(4.5, 75, -38.5, world "runeblade", 135, 0), "swordsmith", "swordsmith")
	registerNPC("Attunement Master", ("%{_grad::attunement}%", "", formatParagraph("&7Apply an <#F0F0F0>&nattunement&7 to each weapon!"), "", "&6&lCLICK &6to View"), location(-5.5, 75, -38.5, world "runeblade", 225, 0), "attunement", "attunement")

	registerNPC("Cosmetics", ("%{_grad::cosmetics}%", "", formatParagraph("&7Equip unique armours, suffixes and more!"), "", "&6&lCLICK &6to View"), location(-36, 74, -33, world "runeblade", -90, 0), "cosmetics", "cosmetics")
	registerNPC("Skills", ("%{_grad::skills}%", "", formatParagraph("&7Equip minor buffs for your character!"), "", "&6&lCLICK &6to View"), location(30, 75, -33, world "runeblade", 90, 0), "skills", "skills")
	registerNPC("Challenges", ("%{_grad::challenges}%", "", formatParagraph("&7Complete challenges to unlock more content!"), "", "&6&lCLICK &6to View"), location(-0.5, 75, 3.5, world "runeblade", 180, 0), "challenges", "challenges")
	registerNPC("Dungeons", ("%{_grad::dungeons}%", "", formatParagraph("&7Enter randomly generated dungeons and fight with your team!"), "", "&6&lCLICK &6to View"), location(-0.5, 75, 24.5, world "runeblade", 180, 0), "dungeons", "dungeons")

	registerNPC("Tutorial", ("%{_grad::tutorial}%", "", formatParagraph("&7Learn more about how to play the game!"), "", "&6&lCLICK &6to Start"), location(7.5, 75, -54.5, world "runeblade", 90, 0), "tutorial", "tutorial")


# for use with NPCs
function setSkin(mannequin: entity, value: string, signature: string):
	set {_nbtcompound} to nbt from "{name:"""",properties:[{name:""textures"",signature:""%{_signature}%"",value:""%{_value}%""}]}"
	set compound tag "profile" of nbt of {_mannequin} to {_nbtcompound}








on bound enter:
	wait 1 tick
	set {_ind} to (bound value "npc" of event-bound)
	set {_npc} to {_ind} parsed as entity

	{-guard::%{_ind}%} isn't set
	set {-guard::%{_ind}%} to true
	while (size of all players in bound event-bound) > 0:
		set {_target} to nearest player at {_npc}
		set {_v} to vector from {_npc} to {_target}
		set {_curr} to vector in direction of {_npc}
		set {_v}'s vector length to 0.5

		set {_join} to normalized ({_curr} + {_v})
		if {_npc}'s yaw != {_join}'s yaw:
			set {_npc}'s yaw to {_join}'s yaw
		if {_npc}'s pitch != {_join}'s pitch:
			set {_npc}'s pitch to {_join}'s pitch

		wait 2 ticks
	
	clear {-guard::%{_ind}%}

	while {_npc}'s pitch != 0:
		exit all loops if {-guard::%{_ind}%} is set
		set {_v} to vector in direction of {_npc}
		set {_v}'s pitch to 0
		set {_curr} to vector in direction of {_npc}
		set {_v}'s vector length to 0.5

		set {_join} to normalized ({_curr} + {_v})
		if {_npc}'s yaw != {_join}'s yaw:
			set {_npc}'s yaw to {_join}'s yaw
		if {_npc}'s pitch != {_join}'s pitch:
			set {_npc}'s pitch to {_join}'s pitch

		wait 2 ticks
