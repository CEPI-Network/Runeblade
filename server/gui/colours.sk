# migrate from "hellbent dagger;ignition" --> "hellbent_dagger-ignition"
function migrateSyst():
	loop (indices of {data::*}) where [{data::%input%::colours::*} is set]:
		loop {data::%loop-value%::colours::*}:
			set {_txt} to loop-value-2
			replace all ";" in {_txt} with "-"
			replace all " " in {_txt} with "_"
			set {data::%loop-value-1%::colours::%loop-counter-2%} to {_txt}
		add 1 to {_c}
	broadcast "%{_c} ? 0%"

function migrate2():
	loop (indices of {data::*}) where [{data::%input%::equipped::colours::*} is set]:
		clear {data::%loop-value%::equipped::colours::*}




function registerColour(name: text, item: item, hit: integer, col: objects, kill-req: integer, hidden: boolean=false, palettes: texts=""):
	set {_index} to uncolored {_name} in lowercase
	if {_index} contains "»":
		replace all " » " in {_index} with "-"
	replace all " " in {_index} with "_"

	set {_spl::*} to {_index} split at "-"

	set {_model} to item model of {_item}
	replace all "pair" in {_model} with "main"

	set {-colours::%{_index}%::name} to {_name}
	set {-colours::%{_index}%::item} to {_item}
	set {-colours::%{_index}%::weapon} to {_spl::1}
	set {-colours::%{_index}%::kill-req} to {_kill-req}
	set {-colours::%{_index}%::hidden} to {_hidden}
	set {-colours::%{_index}%::palettes::*} to {_palettes::*}
	set {-colours::%{_index}%::model-data} to {_model}
	
	# reversed -> first col brightest, last col darkest
	loop reversed {_col::*}:
		set {-colours::%{_index}%::%{_hit}%::%loop-counter%} to loop-value

	loop (indices of {-colours::*}) where [{-colours::%input%::hidden} = false]:
		set {_entry::%loop-counter%} to {-colours::%loop-value%::order} ? 0
	set {-colours::%{_index}%::order} to max({_entry::*}) + 1



function openWeaponColours(p: player, menu: string="main"):

	create gui with virtual chest inventory with 5 rows named "&b&l      WEAPON COLOURS":
		open gui to {_p}

		format gui slot (integers between 0 and 8) with light blue stained glass pane named "&0"
		format gui slot (integers between 36 and 44) with black stained glass pane named "&0"
		format gui slot 40 with arrow named "&a&lBACK" with lore "", "&7Return to the previous menu." and "" with all item flags:
			if {_menu} = "main":
				openCosmetics({_p})
			else:
				openWeaponColours({_p}, "main")



		if {_menu} = "main":
			format gui slot 21 with golden sword named "&6&lMASTERY SKINS" with lore "", formatParagraph("Unlock weapon skins after reaching a kill requirement!"), "" with all item flags:
				openWeaponColours({_p}, "mastery")
			format gui slot 23 with iron pickaxe named "&d&lCUSTOM SKINS" with lore "", formatParagraph("Buy and create custom skins from our store!"), "" with all item flags:
				openWeaponColours({_p}, "custom")

		else:

			set {_slot} to 12
			if {_menu} = "mastery":			
				set {_ind::*} to sorted indices of {-sorted-colours::*} in ascending order
			else if {_menu} = "custom":
				loop {data::%uuid of {_p}%::colours::*}: # paid for colours
					indices of {-sorted-colours::*} doesn't contain loop-value
					add loop-value to {_ind::*}

			if size of {_ind::*} = 0:
				format gui slot 22 with barrier named "&c&lNO CUSTOM SKINS" with lore "", formatParagraph("You don't own any custom skins! Buy one in the store! &8(&e/buy&8)"), "" with all item flags
				stop

			loop {_ind::*}:
				set {_name} to {-colours::%loop-value%::name}
				set {_item} to {-colours::%loop-value%::item}
				set {_kill-req} to {-colours::%loop-value%::kill-req}
				set {_weapon} to {-colours::%loop-value%::weapon}
				set {_palettes::*} to {-colours::%{_weapon}%::palettes::*}

				# don't feel like changing how weapon indices are saved EVERYWHERE for colour changes
				set {_kill-weapon} to {_weapon}
				replace all "_" in {_kill-weapon} with " "


				# owns colour palette
				if any:
					{data::%uuid of {_p}%::kills::%{_kill-weapon}%} >= {_kill-req}
					{data::%uuid of {_p}%::colours::*} contains loop-value
				then:
				
					if {data::%uuid of {_p}%::kills::%{_kill-weapon}%} >= {_kill-req}:
						set {_display::*} to "&fRequires: &e%{_kill-req}% %{_weapon} in strict proper case% Kills", "&fYour Kills: &a%{data::%uuid of {_p}%::kills::%{_kill-weapon}%} ? 0% &8(&a✔&8)"
					else:
						set {_display::*} to "&eThanks for supporting the server!"
				
					if loop-value contains {data::%uuid of {_p}%::equipped::colours::%{_weapon}%}:
						enchant {_item} with unbreaking 1
						set {_lore::*} to "&e&lCLICK TO UNEQUIP"
					else:
						set {_lore::*} to "&a&lCLICK TO EQUIP"
					set {_target} to loop-value
					format gui slot {_slot} with {_item} named {_name} with lore "&8ᴄᴏʟᴏᴜʀ sᴇᴛ", "", {_display::*}, "", "", {_lore::*} and "" with all item flags:
						toggleCosmetic({_p}, "colours", {_target})
						openWeaponColours({_p}, {_menu})
				
				else:
					set {_lore::*} to "&c&lLOCKED"

					format gui slot {_slot} with {_item} named {_name} with lore "&8ᴄᴏʟᴏᴜʀ sᴇᴛ", "", "&fRequires: &e%{_kill-req}% %{_weapon} in strict proper case% Kills", "&fYour Kills: &c%{data::%uuid of {_p}%::kills::%{_kill-weapon}%}% &8(&c✘&8)", "", "", {_lore::*} and "" with all item flags:
						play sound "block.note_block.pling" at pitch 0.5 to {_p}
						send "%prefix()% You don't have enough kills to equip that! &8(&7Missing &f%difference between {data::%uuid of {_p}%::kills::%{_weapon}%} and {_kill-req}%&8)" to {_p}
							
				
				add 9 to {_slot}
				mod(loop-counter, 3) = 0:
					remove 26 from {_slot}





function getWeaponColour(p: player, weapon: text) :: text:
	# returns the index to use in {-colours::%{_index}%::hit::section}

	replace all " " in {_weapon} with "_"

	# no palettes exist for this weapon
	set {_palettes::*} to {-colours::%{_weapon}%::palettes::*}
	if any:
		{_palettes::*} = ""
		{_palettes::*} is not set
	then:
		return {_weapon} 


	if {_palettes::*} contains {data::%uuid of {_p}%::equipped::colours::%{_weapon}%}:
		return "%{_weapon}%-%{data::%uuid of {_p}%::equipped::colours::%{_weapon}%}%"
	else:
		return {_weapon}

