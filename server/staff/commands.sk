on tab complete of "skin":
	set tab completions for position 1 to all players
	set tab completions for position 2 to "default" and all players

command /skin [<player>] [<text>]:
	permission: op
	trigger:
		if arg-1 is not set:
			send "%prefix()% Enter a player!" to player
			stop
		if arg-2 is not set:
			send "%prefix()% Enter a valid skin name!" to player
			stop
		send "&fSet your skin to &e%arg-1% &7> &b%arg-2%" to player
		skin(arg-1, arg-2)
		


